#!/usr/bin/env bash
set -e

# Tectobox Pre-commit Hook
# Checks for:
# 1. Unintended sensitive files/patterns (.env, private keys, database dumps)
# 2. Hardcoded secrets / tokens in staged diffs
# 3. Formatting / linting sanity

echo "[pre-commit] Checking staged files for secrets and safety..."

# 1. Block forbidden files
FORBIDDEN_FILES=(
  "\.env$"
  "\.env\.local$"
  "\.env\.production$"
  "\.pem$"
  "\.key$"
  "\.pkcs12$"
  "\.pfx$"
  "\.sqlite$"
  "\.db$"
  "id_rsa"
  "^\.agents/"
)

STAGED_FILES=$(git diff --cached --name-only)

if [ -n "$STAGED_FILES" ]; then
  for pattern in "${FORBIDDEN_FILES[@]}"; do
    MATCHES=$(echo "$STAGED_FILES" | grep -E "$pattern" || true)
    if [ -n "$MATCHES" ]; then
      echo "ERROR: Attempting to commit forbidden sensitive file(s):"
      echo "$MATCHES"
      echo "Commit rejected by pre-commit hook."
      exit 1
    fi
  done
fi

# 2. Secret regex patterns in staged diffs
SECRET_PATTERNS=(
  "(-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY-----)"
  "((ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{36,})" # GitHub tokens
  "(xox[baprs]-[0-9a-zA-Z]{10,48})" # Slack tokens
  "(AIza[0-9A-Za-z\\-_]{35})" # Google API key
  "(bearer\\s+tk_[a-f0-9]{40,})" # Tectonic API keys
)

for pattern in "${SECRET_PATTERNS[@]}"; do
  MATCHES=$(git diff --cached -U0 -I'^[a-zA-Z0-9_]*=' | grep -E "^\+" | grep -E "$pattern" || true)
  if [ -n "$MATCHES" ]; then
    echo "ERROR: Found potential hardcoded secret matching pattern: $pattern"
    echo "$MATCHES"
    echo "Commit rejected by pre-commit hook."
    exit 1
  fi
done

echo "[pre-commit] All security sanity checks passed."
exit 0
