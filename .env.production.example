# ==============================================================================
# Tectobox Production Environment Variables Template (.env.production.example)
# Copy this file to .env on the production VPS or let scripts/deploy.sh auto-generate it.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Docker Image Configuration
IMAGE_REPO_OWNER=th3urbanguy
IMAGE_TAG=latest

# Production Gateway / Domain Configuration
# Set your domain (e.g. DOMAIN=app.tectobox.com) to automatically get HTTPS via Let's Encrypt.
# Leave blank (DOMAIN=) or omit to serve plain HTTP over IP on port 80.
DOMAIN=

# PostgreSQL Database (Internal only, not exposed to public internet)
POSTGRES_USER=tectobox
POSTGRES_PASSWORD=replace_with_strong_password_min_24_chars
POSTGRES_DB=tectobox

# Redis (Internal only)
REDIS_PASSWORD=replace_with_strong_password_min_24_chars

# RabbitMQ (Internal only)
RABBITMQ_USER=tectobox
RABBITMQ_PASS=replace_with_strong_password_min_24_chars

# Security & Authentication
JWT_SECRET=replace_with_random_32_byte_secret_hex

# Optional Channel Webhook Verification
META_APP_SECRET=
META_VERIFY_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional AI Providers (Direct API keys if not using built-in Gemini Web2API)
GEMINI_API_KEY=
OPENAI_API_KEY=
