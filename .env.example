# Copy to .env and fill in. Never commit .env.
# The app runs fully in DEMO mode with no secrets set.

# Port for the web UI + API
PORT=3120

# Set to production in production. Enables Secure cookies (HTTPS-only).
NODE_ENV=development

# --- First-run admin bootstrap (run ONCE, then remove from .env) ---
# BOOTSTRAP_ADMIN=1
# ADMIN_PASSWORD=<12+ characters, required with BOOTSTRAP_ADMIN=1>

# --- Webhook dev mode (NEVER in production) ---
# DEMO_WEBHOOKS=1 accepts UNSIGNED Meta/Telegram webhooks. Default is fail-closed.

# --- AI endpoint SSRF allowlist ---
# If AI_BASE_URL is not loopback, its hostname must be listed here (comma-separated).
# AI_URL_ALLOWLIST=api.example.com

# --- Meta OAuth (per-client Facebook Page connect) ---
# App ID from developers.facebook.com → your app → Settings → Basic.
# Required for the "Connect Facebook Page" OAuth flow.
META_APP_ID=

# --- Database ---
# DB_PATH=/full/path/to/tectonic-inbox.db  (default: ./tectonic-inbox.db)

# --- Meta (Messenger + Instagram) — webhook + page-token flow ---
# Token Meta shows you when configuring the webhook (you choose this value)
META_VERIFY_TOKEN=
# App secret from developers.facebook.com → your app → Settings → Basic
META_APP_SECRET=
# Page access token (Messenger + Instagram send). Get it from your Meta app's
# Messenger product settings after connecting a Facebook Page.
# NOTE: Messenger/Instagram only reply inside Meta's 24h messaging window.
META_PAGE_ACCESS_TOKEN=

# --- Telegram bot (Bot API webhook; optional alongside QR login) ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Secret path segment for your webhook URL (you choose this value).
# Set your Telegram webhook to: https://yourdomain/webhooks/telegram/<this-secret>
TELEGRAM_WEBHOOK_SECRET=

# --- Telegram QR login (gramjs user session, per client) ---
# Get these at https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- AI engine (OpenAI-compatible chat endpoint) ---
# Default: the free-model bridge running on this VM.
AI_BASE_URL=http://127.0.0.1:18080/v1
AI_API_KEY=dummy
# Small, fast, no reasoning. Swap for any model the endpoint serves.
AI_MODEL=@cf/zai-org/glm-4.7-flash
