# Production Dockerfile for Node Channel Workers (CI build only)
FROM node:25-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY patches/ ./patches/
COPY packages/ ./packages/
COPY services/workers/ ./services/workers/

RUN pnpm install --frozen-lockfile --config.ignore-scripts=true
RUN pnpm --filter @tectonic/contracts run build
RUN pnpm --filter @tectonic/messaging run build
RUN pnpm --filter @tectonic/coordination run build
RUN pnpm --filter @tectonic/ai-router run build
RUN pnpm --filter @tectonic/workers run build

FROM node:25-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY patches/ ./patches/
COPY packages/ ./packages/
COPY services/workers/ ./services/workers/

COPY --from=builder /app/packages ./packages
COPY --from=builder /app/services/workers/dist ./services/workers/dist

RUN pnpm install --prod --frozen-lockfile --config.ignore-scripts=true

RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
    && chown -R appuser:appgroup /app \
    && mkdir -p /data/sessions && chown -R appuser:appgroup /data/sessions
# NOTE (2026-11-14): /data/sessions must be appuser-owned in the image so a
# FRESH infra_sessiondata volume inherits correct ownership. A pre-existing
# root-owned volume is NOT fixed by this (the mount overlays it) — deploy.sh
# chowns the live volume before every `up` for that case. Without either,
# Baileys mkdir fails EACCES and no WhatsApp QR is ever produced.

USER appuser

# Run node directly (not via pnpm): the container runs as appuser, whose
# corepack has no activated pnpm, so `pnpm` resolves to latest (v12) and
# `pnpm run` dies with ERR_PNPM_VERIFY_DEPS_BEFORE_RUN (it refuses to read
# the package.json `pnpm` field). start is just `node dist/index.js`.
WORKDIR /app/services/workers
CMD ["node", "dist/index.js"]
