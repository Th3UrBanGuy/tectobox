# Dockerfile.dev for CI & Containerized Testing Only
FROM node:25-alpine AS base

# Install PNPM globally and build dependencies
RUN npm install -g pnpm@9
RUN apk add --no-cache bash curl git ca-certificates libc6-compat

# Install Go for multi-service ingress testing
COPY --from=golang:1.22-alpine /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

WORKDIR /workspace

# Copy dependency manifests
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY patches/ ./patches/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/messaging/package.json ./packages/messaging/
COPY packages/coordination/package.json ./packages/coordination/
COPY packages/ai-router/package.json ./packages/ai-router/
COPY services/api/package.json ./services/api/
COPY services/workers/package.json ./services/workers/

# Install dependencies strictly with pnpm
RUN pnpm install --frozen-lockfile

# Copy source trees
COPY packages ./packages
COPY services ./services
COPY infra ./infra

CMD ["pnpm", "-r", "run", "build"]
